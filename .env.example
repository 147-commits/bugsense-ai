# BugSense AI — Environment Variables
# Copy this to .env.local and fill in values

# ─── AI Provider ──────────────────────────────────────────────
# Anthropic API Key (get from https://console.anthropic.com)
AI_API_KEY=sk-ant-your-key-here

# AI Model to use (default: claude-sonnet-4-20250514)
AI_MODEL=claude-sonnet-4-20250514

# ─── Database (Neon serverless Postgres) ─────────────────────
# Get from https://console.neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# NextAuth — used for sessions AND to HMAC-sign OAuth state.
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ─── Secret encryption at rest ───────────────────────────────
# 32-byte AES-256-GCM key. Accepts 64 hex chars or base64.
# Generate one with: openssl rand -hex 32
TOKEN_ENC_KEY=
# JIRA_TOKEN_ENC_KEY is accepted as a fallback for backward compatibility.

# ─── Optional: Redis Cache ────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Optional: Jira integration (OAuth 2.0 3LO) ──────────────
# Create an Atlassian OAuth app at https://developer.atlassian.com/console/myapps
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/jira/callback
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback
# JIRA_DRY_RUN=1   # uncomment to log outbound payloads instead of POSTing
